package components

import (
	"fmt"
	"github.com/enchant97/hasty-paste/app/database"
	"time"
)

templ PastesPage(username string, pastes []database.GetLatestPastesByUserRow, csrfToken string) {
	@base(fmt.Sprintf("%s's Pastes", username)) {
		@header()
		<div class="p-2">
			<h1 class="my-2 text-center">{ fmt.Sprintf("%s's Pastes", username) }</h1>
			if getCurrentUsername(ctx) != "anonymous" && getCurrentUsername(ctx) == username {
				<form
                    class="flex justify-center gap-2 mx-auto"
                    method="post"
                    action="/manage/user/_delete"
                >
                    <input type="hidden" name="csrfToken" value={csrfToken} />
					<label class="input input-confirm">
						Delete Account
						<input class="input-confirm-request" type="checkbox"/>
						<button class="btn btn-error input-confirm-confirm" type="submit">Confirm Deletion</button>
					</label>
				</form>
			}
			<ul class="flex flex-col gap-2 mt-4">
				for _, paste := range pastes {
					<li
						data-paste-id={ paste.ID.String() }
						class="p-4 rounded-2xl shadow-glass duration-200 bg-base-light-100 dark:bg-base-dark-100 shadow-sm hover:bg-base-light-300 dark:hover:bg-base-dark-300"
					>
						<a href={ templ.URL(fmt.Sprintf("/@/%s/%s", username, paste.Slug)) }>
							<span class="block">{ paste.Slug }</span>
							<span class="text-xs block ml-4">
								by
								<span class="italic">
									{ username }
								</span>
								at
								<time class="italic" datetime={ paste.CreatedAt.Format(time.RFC3339) }>
									{ paste.CreatedAt.Format(time.DateOnly) }
								</time>
								-
								<span class="italic">
									({ paste.Visibility })
								</span>
							</span>
						</a>
					</li>
				}
			</ul>
		</div>
		@footer()
	}
}

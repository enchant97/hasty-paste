package components

import (
	"fmt"

    "github.com/enchant97/hasty-paste/app/core"
)

templ UserLoginPage(internalLoginEnabled bool, internalSignupEnabled bool, oidcConfig core.OIDCConfig, csrfToken string) {
@base("Sign In") {
@header()
<div class="p-2">
    <h1 class="my-2 text-center">Sign In</h1>
    if internalLoginEnabled {
    <form class="flex flex-col gap-2 max-w-md mx-auto" method="post"
        action="/login/_post">
        <input type="hidden" name="csrfToken" value={csrfToken} />
        <label class="flex flex-col gap-2">
            <span class="label-text">Username</span>
            <input class="input" type="text" name="username" autocomplete="username" required />
        </label>
        <label class="flex flex-col gap-2">
            <span class="label-text">Password</span>
            <input class="input" type="password" name="password" autocomplete="current-password" required />
        </label>
        <button class="btn btn-primary" type="submit">Sign In</button>
        if oidcConfig.Enabled {
        <a class="btn btn-primary" href={templ.URL(fmt.Sprintf("/sso/oidc?csrfToken=%s", csrfToken))}>Sign In With { oidcConfig.Name }</a>
        }
        if internalSignupEnabled {
        <a class="btn btn-neutral" href="/signup">Sign Up Instead?</a>
        }
    </form>
    } else if oidcConfig.Enabled {
    <a class="btn btn-primary max-w-fit block mx-auto my-20" href={templ.URL(fmt.Sprintf("/sso/oidc?csrfToken=%s", csrfToken))}>Sign In With { oidcConfig.Name }</a>
    }
</div>
@footer()
}
}
